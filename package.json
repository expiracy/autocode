{
  "name": "opencode-autocode",
  "version": "0.1.0-beta.2",
  "description": "Model-based command approval for OpenCode 2",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/expiracy/autocode.git"
  },
  "homepage": "https://github.com/expiracy/autocode#readme",
  "bugs": {
    "url": "https://github.com/expiracy/autocode/issues"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "autocode",
    "permissions",
    "command-approval",
    "ai"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org",
    "tag": "next"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./index.js"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "import": "./tui.js"
    },
    "./rpc": {
      "types": "./dist/rpc.d.ts",
      "import": "./dist/rpc.js"
    }
  },
  "main": "./index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "index.js",
    "tui.js",
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "RELEASING.md",
    "docs/assets/settings.png",
    "docs/assets/review-log.png",
    "examples"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.ts test/*.test.mjs",
    "lint:workflows": "node scripts/lint-workflows.mjs",
    "artifact:build": "npm run build && node scripts/release-artifact.mjs build",
    "smoke": "npm run build && node test/smoke.mjs",
    "smoke:registry": "npm run build && node test/smoke.mjs --registry-install",
    "smoke:published": "node test/smoke.mjs --published-package",
    "test:live": "node test/live-provider.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "release:check": "npm run typecheck && npm test && npm run lint:workflows",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2.0.28 <3"
  },
  "devDependencies": {
    "@opencode/plugin": "2.0.28",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "jsonc-parser": "3.3.1"
  }
}
