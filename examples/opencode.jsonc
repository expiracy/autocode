{
  "$schema": "https://opencode.ai/config.json",
  // Merge into your GLOBAL OpenCode v2 configuration for /autocode config.
  // Release status: this beta has not been published to npm yet.
  "plugins": [
    {
      // After publication:
      "package": "opencode-autocode@0.1.0-beta.1",
      // Before publication, use your absolute checkout path instead:
      // "package": "/absolute/path/autocode",
      // Build a local checkout with npm ci and npm run build before loading it.
      "options": {
        // Omit model to inherit the proposing assistant's model and variant.
        // Or use "model": "provider/model" for a connected reviewer.
        // For a supported variant, use:
        // "model": { "providerID": "provider", "id": "model", "variant": "high" },
        "enabled": true,
        "timeoutMs": 30000,
        "maxContextChars": 64000
      }
    }
  ],
  // Keep existing permission rules and policies. AutoCode only reviews "ask".
  // The last matching rule wins: put broad rules BEFORE specific exceptions.
  "permissions": [
    { "action": "shell", "resource": "*", "effect": "ask" }
    // Keep existing specific allow/deny rules here, after the broad ask rule.
  ]
}
